[Unit]
Description=Noether company pilot sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noet
Group=noet
StateDirectory=noet
StateDirectoryMode=0750
ExecStart=/usr/local/bin/noet up --config /etc/noet/config.yaml
Restart=on-failure
RestartSec=5

# Noether is intentionally unauthenticated. Keep this service bound behind an
# IAP, authenticated reverse proxy, private network, or service mesh policy.

[Install]
WantedBy=multi-user.target
