[Unit]
Description=Noether company pilot sidecar with PostgreSQL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noet
Group=noet
StateDirectory=noet
StateDirectoryMode=0750
EnvironmentFile=/etc/noet/noet.env
ExecStart=/usr/local/bin/noet up --config /etc/noet/config.yaml
Restart=on-failure
RestartSec=5

# /etc/noet/noet.env should define NOET_DATABASE_URL without committing secrets.
# Noether is intentionally unauthenticated. Keep this service bound behind an
# IAP, authenticated reverse proxy, private network, or service mesh policy.

[Install]
WantedBy=multi-user.target
